# CapCheck AI — Production & Deployment Environment Configuration
# ====================================================================

# --------------------------------------------------------------------
# BACKEND SERVICE CONFIGURATION (FastAPI on Render / Railway / Fly.io)
# --------------------------------------------------------------------
PROJECT_NAME="CapCheck AI"
DEBUG=false
DEMO_MODE=true

# Security & Secret Key (Generate a random 32+ character string in production)
SECRET_KEY="replace-with-a-random-secret-key-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins: comma-separated list of frontend URLs
# Note: https://*.netlify.app is automatically allowed by default
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://capcheck-ai.netlify.app"

# Database Configuration
# Defaults to absolute SQLite path in storage/capcheck.db; or PostgreSQL: postgresql://user:pass@host:5432/dbname
# DATABASE_URL="sqlite:///storage/capcheck.db"

# External News & Fact-Checking API Keys (Optional — CapCheck AI includes built-in curated databases, DuckDuckGo, and Wikipedia fallbacks)
GOOGLE_FACTCHECK_API_KEY=""  # Google FactCheck Tools API (https://toolbox.google.com/factcheck/apis)
BING_SEARCH_API_KEY=""       # Microsoft Bing News / Web Search v7 (https://www.microsoft.com/en-us/bing/apis/bing-web-search-api)
NEWS_API_KEY=""              # NewsAPI.org Live Global News Index (https://newsapi.org)
SERPER_API_KEY=""            # Serper Google Search API (https://serper.dev)
OPENAI_API_KEY=""            # OpenAI API Key (optional for LLM verification enhancement)
HUGGINGFACE_TOKEN=""         # HuggingFace Token (optional for specialized AI detectors)

# Rate Limiting & Storage Retention
RATE_LIMIT_REQUESTS_PER_MINUTE=60
BURST_LIMIT=20
RETENTION_HOURS=48

# Maximum File Upload Sizes in Megabytes
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=150
MAX_AUDIO_SIZE_MB=50

# --------------------------------------------------------------------
# FRONTEND CLIENT CONFIGURATION (Netlify / Vite / Next.js)
# Set these in: Netlify Dashboard -> Site Configuration -> Environment variables
# --------------------------------------------------------------------
# Decoupled backend URL pointing to your live FastAPI deployment:
VITE_API_URL="https://your-capcheck-backend.onrender.com"
NEXT_PUBLIC_API_URL="https://your-capcheck-backend.onrender.com"
