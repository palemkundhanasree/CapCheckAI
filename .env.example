# CapCheck AI — Configuration & Environment Variables

# Application Settings
PROJECT_NAME="CapCheck AI"
DEBUG=false
DEMO_MODE=true

# Security & CORS
SECRET_KEY="replace-with-a-random-secret-key-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for local zero-config execution)
# To use PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/capcheck"
DATABASE_URL="sqlite:///storage/capcheck.db"

# Optional External API Keys (CapCheck functions without these using built-in datasets and open APIs)
# Google Fact Check Tools API: https://toolbox.google.com/factcheck/apis
GOOGLE_FACTCHECK_API_KEY=""

# Optional Web Search API Key (Bing)
BING_SEARCH_API_KEY=""

# Optional LLM Summarization API Key (OpenAI)
OPENAI_API_KEY=""

# Rate Limiting & Storage Retention
RATE_LIMIT_REQUESTS_PER_MINUTE=60
BURST_LIMIT=20
RETENTION_HOURS=48

# Maximum Upload Sizes in Megabytes
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=150
MAX_AUDIO_SIZE_MB=50


# Email (SMTP) for password-reset and email sign-in codes. Without these, no email can be sent.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-character Google App Password>, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
OTP_TTL_MINUTES=10
# Local testing only: returns the code in the API response when SMTP is not configured
EXPOSE_DEV_OTP=false

# Google Gemini - used to fact-check text claims and produce the percentage table.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_GROUNDING=true
