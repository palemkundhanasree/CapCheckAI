# CapCheck AI Frontend — Netlify Environment Variables
# Set these in your Netlify Site Configuration:
# Netlify Dashboard -> Site settings -> Environment variables

# Points to your decoupled FastAPI backend service (Render, Railway, Fly.io, etc.)
# Both VITE_API_URL and NEXT_PUBLIC_API_URL are supported interchangeably
VITE_API_URL="https://your-capcheck-backend.onrender.com"
NEXT_PUBLIC_API_URL="https://your-capcheck-backend.onrender.com"
